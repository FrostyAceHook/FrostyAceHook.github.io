source "https://rubygems.org"

# Minimal setup. This site uses no plugins, so plain Jekyll builds it
# identically to GitHub's own build - and installs a lot faster on Windows.
gem "jekyll", "~> 4.3"

# Required on Ruby 3.x (no longer bundled with Ruby).
gem "webrick", "~> 1.8"

# Faster file-watching on Windows.
gem "wdm", "~> 0.2", platforms: [:mingw, :x64_mingw, :mswin]

# ── Alternative ───────────────────────────────────────────────────────
# If you ever want to mirror GitHub's exact Jekyll version, comment out
# the "jekyll" line above and uncomment this instead. Slower to install.
#
# gem "github-pages", group: :jekyll_plugins
